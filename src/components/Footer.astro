---
// Footer.astro
---

<footer
  class="bg-cafe-dark text-white pt-16 pb-12 border-t border-cafe-medium/20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Row -->
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-8 pb-10"
    >
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <!-- Coffee cup icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 text-white transition-transform group-hover:scale-110"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.75 9.75h4.5m-4.5 3h4.5m-4.5 3h3.5m-6.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V9.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 9.75v7.5a2.25 2.25 0 0 0 2.25 2.25Z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M18.75 7.5a2.25 2.25 0 0 1 2.25 2.25v2.25a2.25 2.25 0 0 1-2.25 2.25H18"
          ></path>
        </svg>
        <span class="text-xl font-bold font-serif text-white tracking-wide"
          >Cafe</span
        >
      </a>

      <!-- Quick Links -->
      <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2">
        <a
          href="/"
          class="text-sm text-white/80 hover:text-white hover:underline transition-colors"
          >Home</a
        >
        <a
          href="/aboutus"
          class="text-sm text-white/80 hover:text-white hover:underline transition-colors"
          >About Us</a
        >
        <a
          href="/menu"
          class="text-sm text-white/80 hover:text-white hover:underline transition-colors"
          >Menu</a
        >
        <a
          href="/faq"
          class="text-sm text-white/80 hover:text-white hover:underline transition-colors"
          >FAQ</a
        >
        <a
          href="/contactus"
          class="text-sm text-white/80 hover:text-white hover:underline transition-colors"
          >Contact Us</a
        >
      </nav>

      <!-- CTA Button -->
      <div>
        <a
          href="/menu"
          class="inline-flex items-center justify-center px-6 py-2.5 bg-cafe-accent hover:bg-cafe-medium text-cafe-charcoal hover:text-white text-sm font-medium rounded-sm transition-all duration-300 cursor-pointer"
        >
          Full Menu
        </a>
      </div>
    </div>

    <!-- Divider Line -->
    <div class="border-t border-white/10 w-full mb-10"></div>

    <!-- Bottom Row -->
    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center text-center lg:text-left"
    >
      <!-- Address Block -->
      <div
        class="flex items-center justify-center lg:justify-start space-x-3 text-sm text-white/80"
      >
        <a
          href="https://maps.app.goo.gl/E8GSMjmooWDMMDEU9"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cafe-accent flex-shrink-0 hover:scale-110 transition-all duration-300"
          title="View on Google Maps"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
            ></path>
          </svg>
        </a>
        <a
          href="https://maps.app.goo.gl/E8GSMjmooWDMMDEU9"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-cafe-accent transition-colors duration-300 text-center lg:text-left"
          title="View on Google Maps"
        >
          Your Cafe Location, Surat, Gujarat 395007
        </a>
      </div>

      <!-- Contact Block -->
      <div
        class="flex items-center justify-center space-x-3 text-sm text-white/80"
      >
        <div class="text-cafe-accent flex-shrink-0">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"
            ></path>
          </svg>
        </div>
        <span
          >(123) 456-7890 &bull; <a
            href="mailto:hello@cafe.com"
            class="hover:text-cafe-accent transition-colors">hello@cafe.com</a
          ></span
        >
      </div>

      <!-- Social Icons Block -->
      <div class="flex items-center justify-center lg:justify-end space-x-6">
        <!-- Instagram -->
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/70 hover:text-white hover:scale-110 transition-all"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
            ></path>
          </svg>
        </a>
        <!-- Facebook -->
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/70 hover:text-white hover:scale-110 transition-all"
          aria-label="Facebook"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path
              d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
            ></path>
          </svg>
        </a>
        <!-- X (formerly Twitter) -->
        <a
          href="https://twitter.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/70 hover:text-white hover:scale-110 transition-all"
          aria-label="X"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
        <!-- TikTok -->
        <a
          href="https://tiktok.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/70 hover:text-white hover:scale-110 transition-all"
          aria-label="TikTok"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path
              d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.99-1.72-.08-.07-.17-.17-.24-.26v6.52a8.533 8.533 0 0 1-1.59 4.93c-1.96 2.52-5.38 3.72-8.54 2.96a8.528 8.528 0 0 1-5.74-5.87c-.82-3.14.3-6.68 2.82-8.66a8.558 8.558 0 0 1 6.89-1.28c-.08 1.4-.04 2.79-.06 4.19a4.42 4.42 0 0 0-4.04 1.95 4.498 4.498 0 0 0-.25 4.67c.78 1.76 2.76 2.85 4.69 2.53a4.5 4.5 0 0 0 3.7-3.8c.08-.66.05-1.32.06-1.97V.02z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Copyright Block -->
    <div class="text-center text-xs text-white/40 mt-12">
      <p>
        &copy; {new Date().getFullYear()} Cafe. All rights reserved. Created in Astro
        JS with Tailwind CSS.
      </p>
    </div>
  </div>
</footer>
