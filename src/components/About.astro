---
import { Image } from 'astro:assets';
import circle1 from '../assets/about_circle1.webp';
import circle2 from '../assets/about_circle2.webp';
---

<section id="about" class="py-24 bg-white overflow-hidden scroll-mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center">
      
      <!-- Overlapping Circular Images Collage -->
      <div class="relative flex justify-center lg:justify-start px-4 sm:px-8 lg:px-0">
        <!-- Combined container for collage to control bounding offsets -->
        <div class="relative w-[320px] h-[320px] sm:w-[440px] sm:h-[440px]">
          
          <!-- Beige Backdrop Circle 1 (Under Image 1, shifted bottom-left) -->
          <div class="absolute bottom-12 left-0 w-[200px] h-[200px] sm:w-[280px] sm:h-[280px] rounded-full bg-cafe-light/50 -z-10"></div>
          
          <!-- Beige Backdrop Circle 2 (Under Image 2, shifted top-right) -->
          <div class="absolute top-12 right-0 w-[200px] h-[200px] sm:w-[280px] sm:h-[280px] rounded-full bg-cafe-light/30 -z-10"></div>
          
          <!-- Image 1 Container: Top-Left (Latte Art) -->
          <div class="absolute top-0 left-4 w-[210px] h-[210px] sm:w-[290px] sm:h-[290px] rounded-full border-8 border-white shadow-xl z-10 transition-transform duration-500 hover:scale-102">
            <Image 
              src={circle1} 
              alt="Premium latte art in white ceramic cup" 
              class="w-full h-full object-cover rounded-full" 
              quality="high"
            />
          </div>

          <!-- Concentric dotted ring around Image 2 (shifted for centering offset) -->
          <div class="absolute bottom-2 right-2 w-[186px] h-[186px] sm:w-[246px] sm:h-[246px] rounded-full border-2 border-dashed border-cafe-accent/80 z-20 pointer-events-none"></div>

          <!-- Image 2 Container: Bottom-Right (Clinking Cups) -->
          <div class="absolute bottom-4 right-4 w-[170px] h-[170px] sm:w-[230px] sm:h-[230px] rounded-full border-8 border-white shadow-xl z-30 transition-transform duration-500 hover:scale-105">
            <Image 
              src={circle2} 
              alt="Friends clinking coffee cups at the cafe" 
              class="w-full h-full object-cover rounded-full" 
              quality="high"
            />
          </div>

        </div>
      </div>

      <!-- About Content -->
      <div class="flex flex-col text-left max-w-xl">
        <h2 class="text-3xl sm:text-[40px] font-serif text-cafe-charcoal font-semibold leading-[1.25] mb-6 tracking-normal">
          Enjoy expertly crafted<br class="hidden sm:inline" /> beverages made from the finest<br class="hidden sm:inline" /> coffee beans.
        </h2>
        <p class="text-base sm:text-lg font-sans text-cafe-text mb-8 leading-relaxed font-light">
          Find delightful treats, and warm, inviting vibes.
        </p>

        <!-- Values Checkmark Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 gap-x-8">
          
          <!-- Value 1 -->
          <div class="flex items-center space-x-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cafe-medium flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span class="text-base font-sans font-medium text-cafe-charcoal">Premium Quality</span>
          </div>

          <!-- Value 2 -->
          <div class="flex items-center space-x-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cafe-medium flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span class="text-base font-sans font-medium text-cafe-charcoal">Community Focused</span>
          </div>

          <!-- Value 3 -->
          <div class="flex items-center space-x-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cafe-medium flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span class="text-base font-sans font-medium text-cafe-charcoal">Cozy Atmosphere</span>
          </div>

          <!-- Value 4 -->
          <div class="flex items-center space-x-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cafe-medium flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span class="text-base font-sans font-medium text-cafe-charcoal">Eco-Friendly Practices</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
