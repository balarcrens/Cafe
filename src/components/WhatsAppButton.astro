---
// WhatsAppButton.astro
---

<div
  class="whatsapp-btn-wrapper fixed bottom-4 sm:bottom-6 right-4 sm:right-6 z-50 flex items-center group pointer-events-none opacity-0 translate-y-4 transition-all duration-700"
>
  <!-- Tooltip (Desktop only) -->
  <span
    class="mr-3 scale-0 origin-right transition-all duration-300 group-hover:scale-100 hidden md:block bg-cafe-charcoal text-white text-xs px-3 py-2 rounded-md shadow-lg border border-cafe-accent/20 font-sans tracking-wide"
  >
    Chat with us on WhatsApp
  </span>

  <!-- Floating Button -->
  <a
    href="https://wa.me/9825515123"
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex items-center justify-center w-14 h-14 bg-[#25D366] text-white rounded-full shadow-lg hover:shadow-[0_0_20px_rgba(37,211,102,0.6)] transition-all duration-300 hover:scale-110 active:scale-95 pointer-events-auto"
    aria-label="Chat on WhatsApp"
  >
    <!-- Outer pulsing ring -->
    <span
      class="absolute inset-0 rounded-full bg-[#25D366]/40 animate-ping-slow"
    ></span>

    <!-- Official SVG Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-8 h-8"
    >
      <path
        d="M12.04 2C6.56 2 2.1 6.46 2.1 11.94c0 1.75.46 3.45 1.33 4.95L2 22l5.27-1.38a9.94 9.94 0 0 0 4.77 1.22h.01c5.48 0 9.95-4.46 9.95-9.95A9.95 9.95 0 0 0 12.04 2zm0 18.05c-1.42 0-2.81-.37-4.03-1.08l-.29-.17-3.13.82.84-3.05-.18-.3a8.12 8.12 0 0 1-1.24-4.33c0-4.48 3.64-8.12 8.12-8.12a8.07 8.07 0 0 1 5.74 2.38 8.08 8.08 0 0 1 2.38 5.74c0 4.48-3.64 8.12-8.11 8.12zm4.46-6.11c-.24-.12-1.43-.71-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.21-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.8-.2-.47-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.57.18 1.09.15 1.5.09.46-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.12-.06-.08-.22-.12-.46-.24z"
      ></path>
    </svg>
  </a>
</div>

<style>
  @keyframes pingSlow {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .animate-ping-slow {
    animation: pingSlow 2.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
</style>

<script>
  // Fade in the WhatsApp button on load after a small delay
  window.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.querySelector(".whatsapp-btn-wrapper");
    if (wrapper) {
      setTimeout(() => {
        wrapper.classList.remove("opacity-0", "translate-y-4");
        wrapper.classList.add("opacity-100", "translate-y-0");
      }, 1000);
    }
  });
</script>
