---

---

<header
  class="absolute top-0 left-0 right-0 z-50 transition-colors duration-300"
  id="navbar"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <!-- Coffee cup icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 text-white transition-transform group-hover:scale-110"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.75 9.75h4.5m-4.5 3h4.5m-4.5 3h3.5m-6.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V9.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 9.75v7.5a2.25 2.25 0 0 0 2.25 2.25Z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M18.75 7.5a2.25 2.25 0 0 1 2.25 2.25v2.25a2.25 2.25 0 0 1-2.25 2.25H18"
          ></path>
        </svg>
        <span class="text-xl font-bold font-serif text-white tracking-wide"
          >365 The Travel Cafe</span
        >
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-10">
        <a
          href="#"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >Home</a
        >
        <a
          href="#about"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >About Us</a
        >
        <a
          href="#menu"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >Menu</a
        >
        <a
          href="#faq"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >FAQ</a
        >
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a
          href="#booking"
          class="inline-flex items-center justify-center px-6 py-2.5 border border-white text-sm font-medium text-white hover:bg-white hover:text-cafe-charcoal rounded-sm transition-all duration-300"
        >
          Book a Table
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-button"
          type="button"
          class="text-white hover:text-cafe-accent focus:outline-none transition-colors"
          aria-label="Toggle menu"
        >
          <svg
            class="h-6 w-6"
            stroke="currentColor"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              id="menu-icon-open"
              class="inline-flex"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              id="menu-icon-close"
              class="hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Off-screen / Hidden by default) -->
  <div
    id="mobile-menu-drawer"
    class="hidden md:hidden fixed inset-0 z-40 bg-cafe-dark/95 backdrop-blur-md"
  >
    <div class="flex flex-col h-full pt-24 pb-8 px-6 justify-between">
      <nav class="flex flex-col space-y-6 text-center">
        <a
          href="#"
          class="mobile-link text-2xl font-serif text-white hover:text-cafe-accent transition-colors"
          >Home</a
        >
        <a
          href="#about"
          class="mobile-link text-2xl font-serif text-white hover:text-cafe-accent transition-colors"
          >About Us</a
        >
        <a
          href="#menu"
          class="mobile-link text-2xl font-serif text-white hover:text-cafe-accent transition-colors"
          >Menu</a
        >
        <a
          href="#faq"
          class="mobile-link text-2xl font-serif text-white hover:text-cafe-accent transition-colors"
          >FAQ</a
        >
      </nav>
      <div class="flex flex-col items-center space-y-6">
        <a
          href="#booking"
          class="mobile-link w-full text-center py-3 border border-white text-white font-medium rounded-sm hover:bg-white hover:text-cafe-dark transition-all duration-300"
        >
          Book a Table
        </a>
        <span class="text-white/60 text-xs tracking-wider"
          >365 The Travel Cafe &copy; 2026</span
        >
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("navbar");
  const btn = document.getElementById("mobile-menu-button");
  const drawer = document.getElementById("mobile-menu-drawer");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Sticky Navbar background change on scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      nav?.classList.add("bg-cafe-dark/95", "backdrop-blur-md", "shadow-md");
      nav?.classList.remove("absolute");
      nav?.classList.add("fixed");
    } else {
      nav?.classList.remove("bg-cafe-dark/95", "backdrop-blur-md", "shadow-md");
      nav?.classList.remove("fixed");
      nav?.classList.add("absolute");
    }
  });

  // Mobile Menu Toggle
  function toggleMenu() {
    const isHidden = drawer?.classList.contains("hidden");

    if (isHidden) {
      drawer?.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
      openIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      drawer?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  }

  btn?.addEventListener("click", toggleMenu);

  // Close drawer on link click
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      drawer?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
