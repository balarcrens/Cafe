---
// Navbar.astro
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<header
  class={isHome 
    ? "absolute top-0 left-0 right-0 z-50 py-6 transition-all duration-300"
    : "fixed top-0 left-0 right-0 z-50 py-4 bg-cafe-dark shadow-md transition-all duration-300"
  }
  id="navbar"
  data-is-home={isHome ? "true" : "false"}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between transition-all duration-300" id="navbar-container">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <!-- Coffee cup icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 text-white transition-transform group-hover:scale-110"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.75 9.75h4.5m-4.5 3h4.5m-4.5 3h3.5m-6.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V9.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 9.75v7.5a2.25 2.25 0 0 0 2.25 2.25Z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M18.75 7.5a2.25 2.25 0 0 1 2.25 2.25v2.25a2.25 2.25 0 0 1-2.25 2.25H18"
          ></path>
        </svg>
        <span class="text-xl font-bold font-serif text-white tracking-wide"
          >Cafe</span
        >
      </a>

      <!-- Desktop Navigation (Adjusted spacing for screen widths from md to lg) -->
      <nav class="hidden md:flex items-center space-x-5 lg:space-x-8 xl:space-x-10">
        <a
          href="/"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >Home</a
        >
        <a
          href="/aboutus"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >About Us</a
        >
        <a
          href="/menu"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >Menu</a
        >
        <a
          href="/faq"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >FAQ</a
        >
        <a
          href="/contactus"
          class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 decoration-2 decoration-cafe-accent transition-colors"
          >Contact Us</a
        >
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a
          href="/#booking"
          class="inline-flex items-center justify-center px-5 py-2 border border-white text-sm font-medium text-white hover:bg-white hover:text-cafe-charcoal rounded-sm transition-all duration-300"
        >
          Book a Table
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-button"
          type="button"
          class="text-white hover:text-cafe-accent focus:outline-none transition-colors w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/5 cursor-pointer"
          aria-label="Toggle menu"
        >
          <svg
            class="h-6 w-6"
            stroke="currentColor"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              id="menu-icon-open"
              class="inline-flex"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Backdrop Overlay (outside header to avoid containing block issues from backdrop-blur/transforms on parent) -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-[90] bg-cafe-charcoal/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- Mobile Menu Drawer (Slide-in right panel - outside header) -->
<div
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 bottom-0 z-[100] w-full max-w-[340px] bg-cafe-dark/98 backdrop-blur-xl border-l border-white/10 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between p-6 border-b border-white/10">
    <a href="/" class="flex items-center space-x-3 group">
      <!-- Coffee cup icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8 text-white transition-transform group-hover:scale-110"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.75 9.75h4.5m-4.5 3h4.5m-4.5 3h3.5m-6.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V9.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 9.75v7.5a2.25 2.25 0 0 0 2.25 2.25Z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M18.75 7.5a2.25 2.25 0 0 1 2.25 2.25v2.25a2.25 2.25 0 0 1-2.25 2.25H18"
        ></path>
      </svg>
      <span class="text-xl font-bold font-serif text-white tracking-wide"
        >Cafe</span
      >
    </a>

    <!-- Dedicated Close Button inside Drawer Header -->
    <button
      id="mobile-menu-close"
      type="button"
      class="text-white hover:text-cafe-accent w-10 h-10 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/10 transition-colors cursor-pointer"
      aria-label="Close menu"
    >
      <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Drawer Links -->
  <div class="flex-grow overflow-y-auto py-8 px-6">
    <nav class="flex flex-col space-y-6">
      <a
        href="/"
        class="mobile-link text-xl font-serif text-white/90 hover:text-cafe-accent border-b border-white/5 pb-2 transition-colors"
        >Home</a
      >
      <a
        href="/aboutus"
        class="mobile-link text-xl font-serif text-white/90 hover:text-cafe-accent border-b border-white/5 pb-2 transition-colors"
        >About Us</a
      >
      <a
        href="/menu"
        class="mobile-link text-xl font-serif text-white/90 hover:text-cafe-accent border-b border-white/5 pb-2 transition-colors"
        >Menu</a
      >
      <a
        href="/faq"
        class="mobile-link text-xl font-serif text-white/90 hover:text-cafe-accent border-b border-white/5 pb-2 transition-colors"
        >FAQ</a
      >
      <a
        href="/contactus"
        class="mobile-link text-xl font-serif text-white/90 hover:text-cafe-accent border-b border-white/5 pb-2 transition-colors"
        >Contact Us</a
      >
    </nav>
  </div>

  <!-- Drawer Footer / CTA -->
  <div class="p-6 border-t border-white/10 flex flex-col space-y-4 bg-cafe-charcoal/30">
    <a
      href="/#booking"
      class="mobile-link w-full text-center py-3.5 bg-white text-cafe-charcoal font-semibold rounded-sm hover:bg-cafe-accent hover:text-white transition-all duration-300"
    >
      Book a Table
    </a>
    <div class="text-center text-white/40 text-xs tracking-wider font-sans mt-2">
      Cafe &copy; {new Date().getFullYear()}
    </div>
  </div>
</div>

<script>
  const nav = document.getElementById("navbar");
  const isHome = nav?.getAttribute("data-is-home") === "true";
  
  const openBtn = document.getElementById("mobile-menu-button");
  const closeBtn = document.getElementById("mobile-menu-close");
  const overlay = document.getElementById("mobile-menu-overlay");
  const drawer = document.getElementById("mobile-menu-drawer");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Scroll handler
  const handleScroll = () => {
    if (isHome) {
      if (window.scrollY > 50) {
        nav?.classList.add("bg-cafe-dark/95", "backdrop-blur-md", "shadow-md", "py-3");
        nav?.classList.remove("py-6", "absolute");
        nav?.classList.add("fixed");
      } else {
        nav?.classList.remove("bg-cafe-dark/95", "backdrop-blur-md", "shadow-md", "py-3");
        nav?.classList.add("py-6", "absolute");
        nav?.classList.remove("fixed");
      }
    } else {
      if (window.scrollY > 50) {
        nav?.classList.add("py-3");
        nav?.classList.remove("py-4");
      } else {
        nav?.classList.add("py-4");
        nav?.classList.remove("py-3");
      }
    }
  };

  window.addEventListener("scroll", handleScroll);
  handleScroll(); // Initial check

  // Open Drawer
  function openMenu() {
    drawer?.classList.remove("translate-x-full");
    drawer?.classList.add("translate-x-0");
    
    overlay?.classList.remove("pointer-events-none", "opacity-0");
    overlay?.classList.add("opacity-100", "pointer-events-auto");
    
    document.body.classList.add("overflow-hidden");
  }

  // Close Drawer
  function closeMenu() {
    drawer?.classList.remove("translate-x-0");
    drawer?.classList.add("translate-x-full");
    
    overlay?.classList.remove("opacity-100", "pointer-events-auto");
    overlay?.classList.add("pointer-events-none", "opacity-0");
    
    document.body.classList.remove("overflow-hidden");
  }

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);

  // Close drawer on link clicks
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      closeMenu();
    });
  });

  // Handle window resizing: if screen becomes desktop size, clean up open states
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) {
      closeMenu();
    }
  });
</script>
