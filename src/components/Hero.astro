---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero_background.png';
---

<section class="relative min-h-screen flex items-center justify-center pt-24 overflow-hidden">
  <!-- Optimized Background Image -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={heroBg} 
      alt="Freshly baked croissant and warm caffe latte art on a cozy dark wooden tabletop" 
      class="w-full h-full object-cover" 
      quality="max"
      loading="eager"
    />
    <!-- Deep gradient overlay for premium readability -->
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left w-full pt-16 pb-20 sm:pb-28">
    <div class="max-w-3xl">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif text-white font-normal leading-[1.15] mb-6 tracking-wide drop-shadow-sm">
        Your neighborhood sanctuary for exquisite coffee
      </h1>
      <p class="text-lg sm:text-xl font-sans text-white/80 font-light tracking-wide mb-10 max-w-xl">
        Enjoy expertly crafted beverages. Find peaceful vibes, good company, and freshly brewed perfection every single day.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-wrap gap-4">
        <a 
          href="#menu" 
          class="inline-flex items-center justify-center px-8 py-3.5 bg-cafe-medium hover:bg-cafe-dark text-white text-sm font-semibold tracking-wider uppercase rounded-sm shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5"
        >
          Full Menu
        </a>
        <a 
          href="#about" 
          class="inline-flex items-center justify-center px-8 py-3.5 bg-cafe-accent hover:bg-cafe-light text-cafe-charcoal hover:text-cafe-dark text-sm font-semibold tracking-wider uppercase rounded-sm shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5"
        >
          More Info
        </a>
      </div>
    </div>
  </div>
</section>
