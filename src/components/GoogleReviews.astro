</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>

<script>
  // Scroll Container arrow controls
  const container = document.getElementById("reviews-scroll-container");
  const prevBtn = document.getElementById("reviews-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("reviews-next") as HTMLButtonElement;

  function updateButtons() {
    if (!container || !prevBtn || !nextBtn) return;

    const scrollLeft = container.scrollLeft;
    const scrollWidth = container.scrollWidth;
    const clientWidth = container.clientWidth;

    // Use a tolerance threshold of 5px for minor calculations/rounding issues
    prevBtn.disabled = scrollLeft <= 5;
    nextBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 5;
  }

  if (container && prevBtn && nextBtn) {
    // Scroll handlers
    nextBtn.addEventListener("click", () => {
      const card = container.querySelector(".review-card");
      if (card) {
        const cardWidth = card.getBoundingClientRect().width;
        // gap-6 is 24px in Tailwind CSS
        container.scrollBy({ left: cardWidth + 24, behavior: "smooth" });
      }
    });

    prevBtn.addEventListener("click", () => {
      const card = container.querySelector(".review-card");
      if (card) {
        const cardWidth = card.getBoundingClientRect().width;
        container.scrollBy({ left: -(cardWidth + 24), behavior: "smooth" });
      }
    });

    // Listen to scroll to update button state
    container.addEventListener("scroll", updateButtons, { passive: true });

    // Run initially
    updateButtons();

    // Also run on window resize
    window.addEventListener("resize", updateButtons, { passive: true });
  }
</script>
