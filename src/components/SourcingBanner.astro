---
import { Image } from "astro:assets";
import sourcingBg from "../assets/banner_sourcing.webp";
---

<section
  class="sourcing-section relative py-28 flex items-center justify-center overflow-hidden"
>
  <!-- Background Image with Parallax -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div class="sourcing-bg-wrapper w-full h-full relative">
      <Image
        src={sourcingBg}
        alt="Lush green coffee branches with ripe red coffee cherries in sunlight"
        class="sourcing-bg-img w-full h-[120%] object-cover absolute top-[-10%] left-0 will-change-transform"
        quality="high"
      />
    </div>
    <!-- Rich overlay matching theme -->
    <div class="absolute inset-0 overlay-green z-1"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2
      class="sourcing-heading text-3xl sm:text-5xl text-white font-serif leading-[1.25] font-normal mb-8 max-w-3xl mx-auto tracking-wide opacity-0 gpu-accelerate"
    >
      We source our milk and dairy products from nearby family-owned farms.
    </h2>
    <div class="sourcing-btn-wrapper opacity-0 gpu-accelerate">
      <a
        href="/aboutus"
        class="inline-flex items-center justify-center px-8 py-3.5 bg-cafe-medium hover:bg-cafe-dark text-white text-sm font-semibold tracking-wider uppercase rounded-sm shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5"
      >
        Learn More
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    // Parallax background scroll
    gsap.to(".sourcing-bg-img", {
      scrollTrigger: {
        trigger: ".sourcing-section",
        start: "top bottom",
        end: "bottom top",
        scrub: 1.2
      },
      yPercent: 15,
      ease: "none"
    });

    // Content fade & slide up
    gsap.fromTo(".sourcing-heading", 
      { opacity: 0, y: 30 },
      {
        scrollTrigger: {
          trigger: ".sourcing-section",
          start: "top 75%"
        },
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: "power3.out"
      }
    );

    gsap.fromTo(".sourcing-btn-wrapper", 
      { opacity: 0, y: 20 },
      {
        scrollTrigger: {
          trigger: ".sourcing-section",
          start: "top 72%"
        },
        opacity: 1,
        y: 0,
        duration: 1,
        delay: 0.3,
        ease: "power2.out"
      }
    );
  } else {
    gsap.set(".sourcing-heading, .sourcing-btn-wrapper", { opacity: 1 });
  }
</script>
