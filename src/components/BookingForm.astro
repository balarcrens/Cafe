---
---

<section id="booking" class="py-24 bg-white scroll-mt-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Title -->
    <span class="text-xs uppercase tracking-widest text-cafe-medium font-bold mb-3 block">Reservation</span>
    <h2 class="text-3xl sm:text-5xl font-serif text-cafe-charcoal font-medium mb-12">Book Your Table</h2>

    <!-- Booking Form -->
    <form id="reservation-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Name -->
        <div class="text-left">
          <input 
            type="text" 
            name="name" 
            id="booking-name" 
            placeholder="Name" 
            required 
            class="w-full px-5 py-4 border border-cafe-accent/40 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal font-sans text-sm tracking-wide transition-all placeholder:text-cafe-text/50"
          />
        </div>

        <!-- Email -->
        <div class="text-left">
          <input 
            type="email" 
            name="email" 
            id="booking-email" 
            placeholder="Email" 
            required 
            class="w-full px-5 py-4 border border-cafe-accent/40 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal font-sans text-sm tracking-wide transition-all placeholder:text-cafe-text/50"
          />
        </div>

        <!-- Date -->
        <div class="text-left relative">
          <input 
            type="date" 
            name="date" 
            id="booking-date" 
            required 
            class="w-full px-5 py-4 border border-cafe-accent/40 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal font-sans text-sm tracking-wide transition-all text-cafe-text/75"
          />
        </div>

        <!-- Time -->
        <div class="text-left">
          <input 
            type="time" 
            name="time" 
            id="booking-time" 
            required 
            class="w-full px-5 py-4 border border-cafe-accent/40 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal font-sans text-sm tracking-wide transition-all text-cafe-text/75"
          />
        </div>

        <!-- People count -->
        <div class="text-left">
          <select 
            name="people" 
            id="booking-people" 
            required 
            class="w-full px-5 py-4 border border-cafe-accent/40 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal font-sans text-sm tracking-wide transition-all text-cafe-text/75"
          >
            <option value="" disabled selected>People</option>
            <option value="1">1 Person</option>
            <option value="2">2 People</option>
            <option value="3">3 People</option>
            <option value="4">4 People</option>
            <option value="5">5 People</option>
            <option value="6">6+ People</option>
          </select>
        </div>

        <!-- Submit Button -->
        <div>
          <button 
            type="submit" 
            class="w-full py-4 bg-cafe-dark hover:bg-cafe-medium text-white text-sm font-semibold tracking-wider uppercase rounded-md shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
          >
            Find a Table
          </button>
        </div>

      </div>
    </form>

    <!-- Interactive Custom Success Toast Container -->
    <div 
      id="booking-toast" 
      class="fixed bottom-20 sm:bottom-24 right-4 sm:right-6 lg:right-8 z-100 hidden items-center space-x-4 bg-cafe-dark text-white p-5 rounded-lg shadow-2xl border border-cafe-accent/30 max-w-[calc(100vw-2rem)] sm:max-w-md animate-fade-in-up"
    >
      <div class="p-2 bg-cafe-medium rounded-full text-cafe-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
        </svg>
      </div>
      <div class="text-left">
        <h4 class="font-serif text-lg text-white font-semibold">Reservation Confirmed!</h4>
        <p id="toast-message" class="text-xs text-white/80 font-light mt-1"></p>
      </div>
      <button id="close-toast" class="text-white/50 hover:text-white focus:outline-none transition-colors" aria-label="Close toast">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  const form = document.getElementById('reservation-form') as HTMLFormElement;
  const toast = document.getElementById('booking-toast');
  const toastMsg = document.getElementById('toast-message');
  const closeToastBtn = document.getElementById('close-toast');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Extract values
    const nameInput = document.getElementById('booking-name') as HTMLInputElement;
    const emailInput = document.getElementById('booking-email') as HTMLInputElement;
    const dateInput = document.getElementById('booking-date') as HTMLInputElement;
    const timeInput = document.getElementById('booking-time') as HTMLInputElement;
    const peopleInput = document.getElementById('booking-people') as HTMLSelectElement;

    const name = nameInput.value;
    const email = emailInput.value;
    const date = dateInput.value;
    const time = timeInput.value;
    const people = peopleInput.value;

    // Formatting date nicely
    const dateObj = new Date(date);
    const formattedDate = dateObj.toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });

    // Set toast text content
    if (toastMsg) {
      toastMsg.innerHTML = `Thank you, <strong>${name}</strong>! We've booked a table for <strong>${people} ${parseInt(people) === 1 ? 'person' : 'people'}</strong> on <strong>${formattedDate}</strong> at <strong>${time}</strong>. A confirmation has been sent to <strong>${email}</strong>.`;
    }

    // Display toast
    if (toast) {
      toast.classList.remove('hidden');
      toast.classList.add('flex');
    }

    // Auto-hide toast after 8 seconds
    const timeoutId = setTimeout(() => {
      closeToast();
    }, 8000);

    // Save timeout ID to close button dataset to clear it if clicked early
    if (closeToastBtn) {
      closeToastBtn.setAttribute('data-timeout-id', timeoutId.toString());
    }

    // Reset form fields
    form.reset();
  });

  function closeToast() {
    if (toast) {
      toast.classList.remove('flex');
      toast.classList.add('hidden');
    }
    const activeTimeout = closeToastBtn?.getAttribute('data-timeout-id');
    if (activeTimeout) {
      clearTimeout(parseInt(activeTimeout));
    }
  }

  closeToastBtn?.addEventListener('click', closeToast);
</script>
