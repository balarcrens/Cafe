---
import { Image } from "astro:assets";
import promoCoffee from "../assets/promo_coffee.jpg";
---

<section
  class="py-20 bg-cafe-light border-t border-b border-cafe-accent/15 overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Text Content (Left Column) -->
      <div class="lg:col-span-7 text-left order-2 lg:order-1">
        <h2
          class="text-3xl sm:text-5xl font-serif text-cafe-charcoal font-medium leading-[1.2] mb-5"
        >
          Enjoy the rich and robust flavors
        </h2>
        <p
          class="text-base sm:text-lg font-sans text-cafe-text mb-8 max-w-xl font-light leading-relaxed"
        >
          Locally roasted coffee, supporting both your taste buds and the local
          community. Every single cup is custom-blended and precision brewed to
          deliver a memorable flavor profile that you'll keep coming back for.
        </p>
        <a
          href="#about"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-cafe-dark hover:bg-cafe-medium text-white text-sm font-semibold tracking-wider uppercase rounded-sm shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5"
        >
          Learn More
        </a>
      </div>

      <!-- Image (Right Column) -->
      <div class="lg:col-span-5 flex justify-center order-1 lg:order-2">
        <div
          class="relative w-72 h-72 sm:w-96 sm:h-96 flex items-center justify-center"
        >
          <!-- Outer subtle glowing shadow under the cup image -->
          <div
            class="absolute w-64 h-64 bg-cafe-accent/10 rounded-full blur-2xl -z-10"
          >
          </div>

          <Image
            src={promoCoffee}
            alt="Top-down view of black coffee cup with cast shadow"
            class="w-full h-full object-contain rounded-full hover:scale-103 transition-transform duration-500"
            quality="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>
