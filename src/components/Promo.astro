---
import { Image } from "astro:assets";
import promoCoffee from "../assets/coffee.png";
---

<section
  class="promo-section py-20 bg-cafe-light border-t border-b border-cafe-accent/15 overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Text Content (Left Column) -->
      <div class="lg:col-span-7 text-center lg:text-left order-2 lg:order-1">
        <span
          class="promo-tag text-xs uppercase tracking-widest text-cafe-medium font-bold mb-3 block gpu-accelerate"
          >Locally Crafted</span
        >
        <h2
          class="promo-heading text-3xl sm:text-5xl font-serif text-cafe-charcoal font-medium leading-[1.2] mb-5 gpu-accelerate"
        >
          Enjoy the rich and robust flavors
        </h2>
        <p
          class="promo-para text-base sm:text-lg font-sans text-cafe-text mb-8 max-w-xl mx-auto lg:mx-0 font-light leading-relaxed gpu-accelerate"
        >
          Locally roasted coffee, supporting both your taste buds and the local
          community. Every single cup is custom-blended and precision brewed to
          deliver a memorable flavor profile that you'll keep coming back for.
        </p>
        <div
          class="promo-btn-wrapper flex justify-center lg:justify-start gpu-accelerate"
        >
          <a
            href="/aboutus"
            class="inline-flex items-center justify-center px-8 py-3.5 bg-cafe-dark hover:bg-cafe-medium text-white text-sm font-semibold tracking-wider uppercase rounded-sm shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5"
          >
            Learn More
          </a>
        </div>
      </div>

      <!-- Image (Right Column) -->
      <div class="lg:col-span-5 flex justify-center order-1 lg:order-2">
        <div
          class="relative w-64 h-64 sm:w-96 sm:h-96 flex items-center justify-center"
        >
          <!-- Outer subtle glowing shadow under the cup image -->
          <div
            class="absolute w-56 h-56 sm:w-80 sm:h-80 bg-cafe-accent/15 rounded-full blur-2xl -z-10"
          >
          </div>

          <div class="promo-cup-wrapper w-full h-full">
            <Image
              src={promoCoffee}
              alt="Top-down view of black coffee cup with cast shadow"
              class="promo-cup-img w-full h-full object-cover hover:scale-103 transition-transform duration-500 will-change-transform"
              quality="high"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    // Parallax cup rotation on scroll
    gsap.to(".promo-cup-img", {
      scrollTrigger: {
        trigger: ".promo-section",
        start: "top bottom",
        end: "bottom top",
        scrub: 1.2,
      },
      rotation: 45,
      ease: "none",
    });

    // Staggered text reveal
    gsap.from(".promo-tag, .promo-heading, .promo-para, .promo-btn-wrapper", {
      scrollTrigger: {
        trigger: ".promo-heading",
        start: "top 80%",
      },
      opacity: 0,
      y: 30,
      stagger: 0.1,
      duration: 1,
      ease: "power2.out",
    });
  }
</script>
