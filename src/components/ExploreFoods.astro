---
import { Image } from 'astro:assets';
import espressoImg from '../assets/product1.png';
import brewedImg from '../assets/product2.png';
import teaImg from '../assets/product3.png';
import pastryImg from '../assets/product4.png';

const foodCategories = [
  { id: 'espresso', name: 'Espresso-based', image: espressoImg, desc: 'Rich espresso shots, lattes, and cappuccinos.' },
  { id: 'brewed', name: 'Brewed Coffee', image: brewedImg, desc: 'Drip coffee, cold brews, and pour-overs.' },
  { id: 'tea', name: 'Tea Selection', image: teaImg, desc: 'Premium matcha, loose-leaf teas, and chai.' },
  { id: 'pastry', name: 'Pastries & Desserts', image: pastryImg, desc: 'Freshly baked croissants, tarts, and scones.' }
];

const featuredItems = [
  { name: 'Cortado', price: '$4.00', desc: 'Equal parts espresso and warm textured milk.', category: 'Espresso-based', tag: 'Barista Choice' },
  { name: 'Nitro Cold Brew', price: '$4.75', desc: 'Infused with nitrogen for a rich, creamy head.', category: 'Brewed Coffee', tag: 'Cold Brew' },
  { name: 'Ceremonial Matcha Latte', price: '$5.00', desc: 'Organic stone-ground green tea whisked with steamed milk.', category: 'Tea Selection', tag: 'Organic' },
  { name: 'Almond Croissant', price: '$4.00', desc: 'Twice-baked croissant with sweet almond frangipane filling.', category: 'Pastries & Desserts', tag: 'Baked Daily' }
];
---

<section class="explore-foods-section py-24 bg-white scroll-mt-12 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Title -->
    <span class="explore-foods-title text-xs uppercase tracking-widest text-[#8b3d1f] font-bold mb-3 block">From Our Kitchen</span>
    <h2 class="explore-foods-heading text-3xl sm:text-5xl font-serif text-cafe-charcoal font-medium mb-12">Explore our Foods</h2>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {foodCategories.map((cat) => (
        <div class="menu-category-card group flex flex-col items-center bg-white rounded-lg p-2 transition-all duration-300 hover:shadow-xl">
          <!-- Image Container with nice smooth zoom on hover -->
          <div class="w-full h-64 rounded-xl overflow-hidden shadow-md mb-6 relative">
            <Image
              src={cat.image} 
              alt={cat.name} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              quality="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-cafe-charcoal/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <!-- Label -->
          <h3 class="text-xl font-serif text-cafe-accent font-semibold mb-2 group-hover:text-cafe-medium transition-colors">
            {cat.name}
          </h3>
          <p class="text-sm text-cafe-text/80 font-sans max-w-[200px] text-center font-light leading-relaxed">
            {cat.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Divider Line -->
    <div class="explore-foods-divider border-t border-cafe-accent/20 w-24 mx-auto my-16"></div>

    <!-- Featured Menu Items Section -->
    <div class="explore-featured-section mb-16 text-left max-w-5xl mx-auto px-4">
      <span class="featured-subtitle text-xs uppercase tracking-widest text-cafe-medium font-bold mb-3 block text-center">Chef's Highlights</span>
      <h3 class="featured-title text-2xl sm:text-3xl font-serif text-cafe-charcoal text-center font-medium mb-12">Our Signature Selections</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
        {featuredItems.map((item) => (
          <div class="featured-menu-item flex flex-col justify-between p-6 bg-cafe-light/10 border border-cafe-accent/15 rounded-lg hover:border-cafe-accent hover:shadow-md transition-all duration-300">
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <h4 class="text-lg font-serif text-cafe-charcoal font-semibold">{item.name}</h4>
                <div class="border-b border-dotted border-cafe-accent/30 flex-grow mx-4 h-1"></div>
                <span class="text-cafe-medium font-bold text-base">{item.price}</span>
              </div>
              <p class="text-sm text-cafe-text font-light leading-relaxed mb-4">{item.desc}</p>
            </div>
            <div class="flex items-center justify-between mt-auto pt-2">
              <span class="text-[10px] uppercase tracking-wider font-semibold text-cafe-accent bg-cafe-light/30 border border-cafe-accent/10 px-2.5 py-0.5 rounded-sm">
                {item.category}
              </span>
              <span class="text-[10px] uppercase tracking-wider font-bold text-cafe-medium">
                {item.tag}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA Button -->
    <a 
      href="/menu"
      class="explore-foods-btn inline-flex items-center justify-center px-10 py-4 bg-cafe-accent hover:bg-cafe-medium text-white text-sm font-semibold tracking-wider uppercase rounded-sm shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
    >
      See Full Menu
    </a>

  </div>
</section>
