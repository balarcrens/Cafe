---
// InfoBar.astro
---

<section
  class="infobar-section bg-cafe-dark py-10 text-white relative z-25 border-b border-cafe-medium/30"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-4 divide-y md:divide-y-0 md:divide-x divide-white/10"
    >
      <!-- Hours -->
      <div
        class="infobar-item flex items-start md:justify-center space-x-4 pt-6 md:pt-0 first:pt-0"
      >
        <div
          class="p-3 bg-white/5 rounded-full text-cafe-accent mt-1 flex-shrink-0"
        >
          <!-- Clock/Calendar Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
            ></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span
            class="text-xs uppercase tracking-widest text-cafe-accent font-semibold mb-1"
            >Opening Hours</span
          >
          <div class="flex space-x-6 text-sm font-light text-white/90">
            <div>
              <span class="font-medium block text-white">Mon – Fri</span>
              <span>8:00 AM – 8:00 PM</span>
            </div>
            <div>
              <span class="font-medium block text-white">Sat – Sun</span>
              <span>7:00 AM – 9:00 PM</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Address -->
      <div
        class="infobar-item flex items-start md:justify-center space-x-4 pt-6 md:pt-0"
      >
        <a
          href="https://maps.app.goo.gl/E8GSMjmooWDMMDEU9"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-white/5 hover:bg-white/10 rounded-full text-cafe-accent mt-1 flex-shrink-0 transition-all duration-300 hover:scale-105"
          title="View on Google Maps"
        >
          <!-- Map Pin Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
            ></path>
          </svg>
        </a>
        <div class="flex flex-col">
          <span
            class="text-xs uppercase tracking-widest text-cafe-accent font-semibold mb-1"
            >Location</span
          >
          <a
            href="https://maps.app.goo.gl/zhbiS46EMKZvU1vG7"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-light leading-relaxed text-white/90 hover:text-cafe-accent transition-colors duration-300"
            title="View on Google Maps"
          >
            <span class="font-semibold block text-white"
              >Your Cafe Location</span
            >
            Cafe Location, Surat, Gujarat 395007
          </a>
        </div>
      </div>

      <!-- Contact -->
      <div
        class="infobar-item flex items-start md:justify-center space-x-4 pt-6 md:pt-0"
      >
        <div
          class="p-3 bg-white/5 rounded-full text-cafe-accent mt-1 flex-shrink-0"
        >
          <!-- Phone/Chat Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"
            ></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span
            class="text-xs uppercase tracking-widest text-cafe-accent font-semibold mb-1"
            >Get in Touch</span
          >
          <p class="text-sm font-light text-white/90">
            <span class="font-semibold block text-white">(123) 456-7890</span>
            <a
              href="mailto:hello@cafe.com"
              class="hover:text-cafe-accent hover:underline transition-all"
              >hello@cafe.com</a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    gsap.from(".infobar-item", {
      scrollTrigger: {
        trigger: ".infobar-section",
        start: "top 85%",
        toggleActions: "play none none none",
      },
      opacity: 0,
      y: 25,
      stagger: 0.15,
      duration: 0.8,
      ease: "power2.out",
    });
  }
</script>
