---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { id: 'all', name: 'All' },
  { id: 'espresso', name: 'Espresso-based' },
  { id: 'brewed', name: 'Brewed Coffee' },
  { id: 'tea', name: 'Tea Selection' },
  { id: 'pastry', name: 'Pastries & Desserts' }
];

const menuData = [
  // Espresso
  { name: 'Espresso', price: '$3.50', desc: 'Double shot of our signature micro-roasted espresso.', category: 'espresso', tags: ['Organic', 'Strong'] },
  { name: 'Cortado', price: '$4.00', desc: 'Equal parts espresso and warm textured milk.', category: 'espresso', tags: ['Classic'] },
  { name: 'Flat White', price: '$4.50', desc: 'Double shot of espresso with thin layer of microfoam.', category: 'espresso', tags: ['Creamy'] },
  { name: 'Caffe Latte', price: '$4.75', desc: 'Espresso and steamed milk with a light layer of foam.', category: 'espresso', tags: ['Popular'] },
  { name: 'Cappuccino', price: '$4.50', desc: 'Espresso, steamed milk, and heavy layer of velvety foam.', category: 'espresso', tags: ['Classic'] },
  
  // Brewed
  { name: 'House Drip', price: '$3.00', desc: 'Medium roast drip coffee with notes of chocolate and hazelnut.', category: 'brewed', tags: ['Balanced'] },
  { name: 'Pour Over', price: '$5.00', desc: 'Single-origin beans brewed meticulously by hand.', category: 'brewed', tags: ['Craft'] },
  { name: 'Cold Brew', price: '$4.25', desc: 'Steeped cold for 18 hours, smooth and low acidity.', category: 'brewed', tags: ['Refreshing'] },
  { name: 'Nitro Cold Brew', price: '$4.75', desc: 'Infused with nitrogen for a rich, creamy head.', category: 'brewed', tags: ['Creamy', 'Strong'] },
  
  // Tea
  { name: 'Ceremonial Matcha Latte', price: '$5.00', desc: 'Organic stone-ground green tea whisked with steamed milk.', category: 'tea', tags: ['Organic', 'Healthy'] },
  { name: 'Chai Tea Latte', price: '$4.75', desc: 'Spiced black tea blend infused with vanilla and steamed milk.', category: 'tea', tags: ['Spicy'] },
  { name: 'Organic Loose Leaf', price: '$3.75', desc: 'Choice of Jasmine Green, Earl Grey, or Peppermint.', category: 'tea', tags: ['Organic'] },
  { name: 'Iced Peach Hibiscus', price: '$4.00', desc: 'Refreshing botanical tea, unsweetened or sweetened.', category: 'tea', tags: ['Sweet', 'Iced'] },
  
  // Pastry
  { name: 'Butter Croissant', price: '$3.50', desc: 'Classic flaky, buttery French pastry baked fresh daily.', category: 'pastry', tags: ['Baked Fresh'] },
  { name: 'Almond Croissant', price: '$4.00', desc: 'Twice-baked croissant with sweet almond frangipane filling.', category: 'pastry', tags: ['Contains Nuts'] },
  { name: 'Seasonal Fruit Tart', price: '$4.50', desc: 'Sweet pastry shell with pastry cream and fresh berries.', category: 'pastry', tags: ['Sweet'] },
  { name: 'Blueberry Scone', price: '$3.50', desc: 'Crumbly house scone filled with organic blueberries.', category: 'pastry', tags: ['Baked Fresh'] }
];
---

<Layout title="Menu - Cafe" description="Explore our full menu, including crafted espressos, pour-overs, organic green tea matcha lattes, and fresh flaky croissants.">
  <Navbar />

  <main class="flex-grow pt-18">
    <!-- Header Banner -->
    <section class="menu-header relative bg-cafe-charcoal py-20 text-white text-center overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-cafe-dark/25 to-cafe-charcoal/90 z-0"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
        <span class="menu-header-tag text-xs uppercase tracking-widest text-cafe-accent font-bold mb-3 block">From Our Kitchen</span>
        <h1 class="menu-header-title text-4xl sm:text-6xl font-serif text-white mb-6">Our Full Menu</h1>
        <p class="menu-header-desc text-base sm:text-lg text-white/80 font-sans font-light max-w-xl mx-auto leading-relaxed">
          Sip, savor, and enjoy. Explore our signature selections, carefully micro-roasted and prepared fresh daily.
        </p>
      </div>
    </section>

    <!-- Filters and Search Controls -->
    <section class="bg-cafe-light/25 py-8 border-b border-cafe-accent/15">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          
          <!-- Tabs Filter -->
          <div class="flex flex-wrap gap-2 justify-center md:justify-start">
            {categories.map(cat => (
              <button
                class="filter-tab px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 cursor-pointer bg-white text-cafe-charcoal border border-cafe-accent/20 hover:border-cafe-accent active-tab:bg-cafe-dark active-tab:text-white"
                data-id={cat.id}
                data-active={cat.id === 'all' ? 'true' : 'false'}
              >
                {cat.name}
              </button>
            ))}
          </div>

          <!-- Search Bar -->
          <div class="relative max-w-md w-full mx-auto md:mx-0">
            <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-cafe-text/60">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              type="text"
              id="menu-search"
              placeholder="Search coffee or pastries..."
              class="w-full pl-11 pr-5 py-3 border border-cafe-accent/30 rounded-full bg-white text-cafe-charcoal focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent text-sm tracking-wide transition-all placeholder:text-cafe-text/40"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- Menu Grid -->
    <section class="py-16 bg-white min-h-[500px]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Empty State -->
        <div id="menu-empty" class="hidden text-center py-20">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-cafe-accent/40 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75h4.5m-4.5 3h4.5m-4.5 3h3.5m-6.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V9.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 9.75v7.5a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
          <h3 class="text-xl font-serif text-cafe-charcoal mb-2 font-medium">No Items Found</h3>
          <p class="text-sm text-cafe-text font-light">Try adjusting your filters or search keywords.</p>
        </div>

        <div id="menu-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
          {menuData.map(item => (
            <div 
              class="menu-item bg-white p-6 sm:p-8 rounded-lg border border-cafe-accent/15 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between"
              data-category={item.category}
              data-name={item.name.toLowerCase()}
              data-desc={item.desc.toLowerCase()}
            >
              <div>
                <!-- Top details -->
                <div class="flex justify-between items-baseline mb-3">
                  <h3 class="text-xl font-serif text-cafe-charcoal font-semibold">{item.name}</h3>
                  <span class="text-cafe-medium font-bold text-base whitespace-nowrap ml-4">{item.price}</span>
                </div>
                <!-- Description -->
                <p class="text-sm text-cafe-text font-light leading-relaxed mb-6">{item.desc}</p>
              </div>
              
              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 mt-auto">
                {item.tags.map(tag => (
                  <span class="text-[10px] uppercase tracking-wider font-semibold text-cafe-accent bg-cafe-light/30 border border-cafe-accent/10 px-2.5 py-0.5 rounded-sm">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Quick Booking CTA Banner -->
    <section class="bg-cafe-dark py-16 text-center text-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl sm:text-3xl font-serif mb-6 font-normal text-white">Craving a cozy coffee chat?</h2>
        <a 
          href="/#booking" 
          class="inline-flex items-center justify-center px-8 py-3.5 bg-cafe-accent hover:bg-cafe-light text-cafe-charcoal hover:text-cafe-dark text-sm font-semibold tracking-wider uppercase rounded-sm shadow-md hover:shadow-lg transition-all duration-300"
        >
          Reserve a Table
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Style for active tab state toggled by script */
  .filter-tab[data-active="true"] {
    background-color: var(--color-cafe-dark);
    color: #ffffff;
    border-color: var(--color-cafe-dark);
  }
</style>

<script>
  // Interactive Client-Side Searching & Filtering (Instant Toggles, No GSAP)
  const tabs = document.querySelectorAll('.filter-tab');
  const searchInput = document.getElementById('menu-search') as HTMLInputElement;
  const menuItems = document.querySelectorAll('.menu-item') as NodeListOf<HTMLDivElement>;
  const emptyState = document.getElementById('menu-empty');

  let activeCategory = 'all';
  let searchVal = '';

  function filterMenu() {
    let visibleCount = 0;

    menuItems.forEach(item => {
      const cat = item.getAttribute('data-category');
      const name = item.getAttribute('data-name') || '';
      const desc = item.getAttribute('data-desc') || '';

      const matchesCategory = activeCategory === 'all' || cat === activeCategory;
      const matchesSearch = name.includes(searchVal) || desc.includes(searchVal);

      if (matchesCategory && matchesSearch) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    // Toggle Empty State
    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('block');
    } else {
      emptyState?.classList.add('hidden');
      emptyState?.classList.remove('block');
    }
  }

  // Bind Tab Clicks
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Toggle active states
      tabs.forEach(t => t.setAttribute('data-active', 'false'));
      tab.setAttribute('data-active', 'true');

      activeCategory = tab.getAttribute('data-id') || 'all';
      filterMenu();
    });
  });

  // Bind Search Keyups
  searchInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    searchVal = target.value.toLowerCase().trim();
    filterMenu();
  });
</script>
