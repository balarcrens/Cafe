---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Contact Us - Cafe"
  description="Get in touch with Cafe in Surat. Send us a message, find our phone number, email address, opening hours, or view our location map."
>
  <Navbar />

  <main class="flex-grow pt-18">
    <!-- Header Banner -->
    <section
      class="contact-header relative bg-cafe-charcoal py-20 text-white text-center overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-gradient-to-b from-cafe-dark/25 to-cafe-charcoal/90 z-0"
      >
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
        <span
          class="contact-header-tag opacity-0 text-xs uppercase tracking-widest text-cafe-accent font-bold mb-3 block"
          >Reach Out</span
        >
        <h1
          class="contact-header-title opacity-0 text-4xl sm:text-6xl font-serif text-white mb-6"
        >
          Contact Us
        </h1>
        <p
          class="contact-header-desc opacity-0 text-base sm:text-lg text-white/80 font-sans font-light max-w-xl mx-auto leading-relaxed"
        >
          Have feedback, catering inquiries, or just want to say hello? We'd
          love to hear from you.
        </p>
      </div>
    </section>

    <!-- Main Content Grid -->
    <section class="contact-content-section py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start"
        >
          <!-- Left: Contact Details Sidebar (5 columns) -->
          <div class="lg:col-span-5 contact-sidebar space-y-8 text-left">
            <div>
              <span
                class="text-xs uppercase tracking-widest text-cafe-medium font-bold mb-3 block"
                >Get In Touch</span
              >
              <h2
                class="text-3xl font-serif text-cafe-charcoal font-semibold mb-6"
              >
                Contact Details
              </h2>
            </div>

            <!-- Detail Items -->
            <div class="space-y-6">
              <!-- Address -->
              <div class="contact-detail-item flex items-start space-x-4">
                <div
                  class="p-3 bg-cafe-light/30 rounded-full text-cafe-medium mt-1 flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                    ></path>
                  </svg>
                </div>
                <div class="flex flex-col text-sm">
                  <span
                    class="font-serif text-cafe-charcoal font-bold text-base mb-1"
                    >Our Location</span
                  >
                  <a
                    href="https://maps.app.goo.gl/zhbiS46EMKZvU1vG7"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-cafe-text font-light leading-relaxed hover:text-cafe-medium transition-colors"
                  >
                    Your Cafe Address, Surat, Gujarat 395007
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="contact-detail-item flex items-start space-x-4">
                <div
                  class="p-3 bg-cafe-light/30 rounded-full text-cafe-medium mt-1 flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 0 1-7.108-7.108c-.155-.44.01-.927.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                    ></path>
                  </svg>
                </div>
                <div class="flex flex-col text-sm">
                  <span
                    class="font-serif text-cafe-charcoal font-bold text-base mb-1"
                    >Phone Call</span
                  >
                  <a
                    href="tel:1234567890"
                    class="text-cafe-text font-light hover:text-cafe-medium transition-colors"
                    >(123) 456-7890</a
                  >
                </div>
              </div>

              <!-- Email -->
              <div class="contact-detail-item flex items-start space-x-4">
                <div
                  class="p-3 bg-cafe-light/30 rounded-full text-cafe-medium mt-1 flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                    ></path>
                  </svg>
                </div>
                <div class="flex flex-col text-sm">
                  <span
                    class="font-serif text-cafe-charcoal font-bold text-base mb-1"
                    >Email Address</span
                  >
                  <a
                    href="mailto:hello@cafe.com"
                    class="text-cafe-text font-light hover:text-cafe-medium transition-colors"
                    >hello@cafe.com</a
                  >
                </div>
              </div>

              <!-- Operating hours -->
              <div
                class="contact-detail-item flex items-start space-x-4 border-t border-cafe-accent/10 pt-6"
              >
                <div
                  class="p-3 bg-cafe-light/30 rounded-full text-cafe-medium mt-1 flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                    ></path>
                  </svg>
                </div>
                <div class="flex flex-col text-sm">
                  <span
                    class="font-serif text-cafe-charcoal font-bold text-base mb-1"
                    >Opening Hours</span
                  >
                  <div class="space-y-1 font-light text-cafe-text">
                    <p>
                      <strong class="font-semibold text-cafe-charcoal"
                        >Mon – Fri:</strong
                      > 8:00 AM – 8:00 PM
                    </p>
                    <p>
                      <strong class="font-semibold text-cafe-charcoal"
                        >Sat – Sun:</strong
                      > 7:00 AM – 9:00 PM
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Interactive Contact Form (7 columns) -->
          <div
            class="lg:col-span-7 contact-form-container bg-cafe-light/10 p-8 sm:p-10 rounded-lg border border-cafe-accent/15 text-left"
          >
            <h3
              class="text-2xl font-serif text-cafe-charcoal font-semibold mb-6"
            >
              Send us a Message
            </h3>

            <form id="contact-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="contact-field text-left">
                  <input
                    type="text"
                    name="name"
                    id="contact-name"
                    placeholder="Name"
                    required
                    class="w-full px-5 py-3.5 border border-cafe-accent/30 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal text-sm font-sans tracking-wide"
                  />
                </div>
                <!-- Email -->
                <div class="contact-field text-left">
                  <input
                    type="email"
                    name="email"
                    id="contact-email"
                    placeholder="Email"
                    required
                    class="w-full px-5 py-3.5 border border-cafe-accent/30 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal text-sm font-sans tracking-wide"
                  />
                </div>
              </div>

              <!-- Subject -->
              <div class="contact-field text-left">
                <input
                  type="text"
                  name="subject"
                  id="contact-subject"
                  placeholder="Subject"
                  required
                  class="w-full px-5 py-3.5 border border-cafe-accent/30 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal text-sm font-sans tracking-wide"
                />
              </div>

              <!-- Message -->
              <div class="contact-field text-left">
                <textarea
                  name="message"
                  id="contact-message"
                  rows="6"
                  placeholder="Your Message..."
                  required
                  class="w-full px-5 py-3.5 border border-cafe-accent/30 rounded-md focus:outline-none focus:ring-2 focus:ring-cafe-medium focus:border-transparent bg-white text-cafe-charcoal text-sm font-sans tracking-wide resize-none"
                ></textarea>
              </div>

              <!-- Submit -->
              <div class="contact-field">
                <button
                  type="submit"
                  class="w-full py-4 bg-cafe-dark hover:bg-cafe-medium text-white text-sm font-semibold tracking-wider uppercase rounded-md shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
                >
                  Send Message
                </button>
              </div>
            </form>

            <!-- Success Alert -->
            <div
              id="contact-success"
              class="hidden mt-6 bg-[#25D366]/10 text-cafe-charcoal p-5 border border-[#25D366]/30 rounded-md items-start space-x-3 animate-fade-in-up"
            >
              <div
                class="p-1 bg-[#25D366] text-white rounded-full mt-0.5 flex-shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="3"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m4.5 12.75 6 6 9-13.5"></path>
                </svg>
              </div>
              <div class="text-sm">
                <h4 class="font-bold text-cafe-charcoal font-serif mb-1">
                  Message Sent Successfully!
                </h4>
                <p class="font-light">
                  Thank you, <span id="success-user-name" class="font-semibold"
                  ></span>. We have received your message and will respond to
                  you shortly.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Embedded Google Map -->
    <section
      class="w-full h-[450px] relative border-t border-cafe-accent/15 bg-cafe-light/10"
    >
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m12!1m8!1m3!1d79114.0318316662!2d72.88694977594152!3d21.2172976837397!3m2!1i1024!2i768!4f13.1!2m1!1scafe!5e1!3m2!1sen!2sin!4v1780983521256!5m2!1sen!2sin"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Cafe Location Map in Surat"
        class="w-full h-full grayscale opacity-85 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
      ></iframe>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // Header timeline animations
  if (!prefersReducedMotion) {
    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
    tl.to(".contact-header-tag", {
      opacity: 1,
      y: 0,
      duration: 1.2,
      startAt: { y: 20 },
    })
      .to(
        ".contact-header-title",
        { opacity: 1, y: 0, duration: 1.2, startAt: { y: 30 } },
        "-=1.0",
      )
      .to(
        ".contact-header-desc",
        { opacity: 1, y: 0, duration: 1.2, startAt: { y: 20 } },
        "-=1.0",
      );

    // Content reveals
    gsap.from(".contact-sidebar", {
      scrollTrigger: { trigger: ".contact-content-section", start: "top 75%" },
      opacity: 0,
      x: -30,
      duration: 1.2,
      ease: "power3.out",
    });

    gsap.from(".contact-detail-item", {
      scrollTrigger: { trigger: ".contact-sidebar", start: "top 70%" },
      opacity: 0,
      y: 20,
      stagger: 0.15,
      duration: 0.8,
      ease: "power2.out",
    });

    gsap.from(".contact-form-container", {
      scrollTrigger: { trigger: ".contact-content-section", start: "top 75%" },
      opacity: 0,
      x: 30,
      duration: 1.2,
      ease: "power3.out",
    });

    gsap.from(".contact-field", {
      scrollTrigger: { trigger: "#contact-form", start: "top 85%" },
      opacity: 0,
      y: 20,
      stagger: 0.1,
      duration: 0.8,
      ease: "power2.out",
    });
  } else {
    gsap.set(
      ".contact-header-tag, .contact-header-title, .contact-header-desc",
      { opacity: 1 },
    );
  }

  // Interactive Contact Form Submission Handler
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const alertBox = document.getElementById("contact-success");
  const userSpan = document.getElementById("success-user-name");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const nameInput = document.getElementById(
      "contact-name",
    ) as HTMLInputElement;
    if (userSpan) {
      userSpan.textContent = nameInput.value;
    }

    // Reset Form Fields
    form.reset();

    // Show success alert
    alertBox?.classList.remove("hidden");
    alertBox?.classList.add("flex");

    // Auto scroll down to success block smoothly
    setTimeout(() => {
      alertBox?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }, 100);
  });
</script>
